# Bluechef Global Academy Environment Configuration
# Copy this file to .env and fill in your values:
#   cp .env.example .env

# Server
PORT=5000
NODE_ENV=development

# Optional isolated demo: BOTH flags are development-only. Never enable for deployment.
# BGA_DEV_MEMORY=true
# VITE_DEMO_MODE=true

# JWT signing secret (required — use a long random string in production)
JWT_SECRET=your-jwt-secret-here

# Standalone mode admin credentials (used when MySQL is unavailable)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-in-development

# MySQL Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=bga_admissions_db

# Optional: frontend API base URL (defaults to /api via Vite proxy)
# VITE_API_URL=/api

# Enable the protected admin routes in the production frontend when needed.
# Authentication and the Supabase admin_users allowlist are still required.
# VITE_ENABLE_ADMIN=true

# Supabase Configuration
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
